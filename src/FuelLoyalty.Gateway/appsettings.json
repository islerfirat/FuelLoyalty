{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "PermitLimit": 10,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "authorizations-route": {
        "ClusterId": "loyalty-cluster",
        "RateLimiterPolicy": "pump-policy",
        "Match": {
          "Path": "/authorizations",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathSet": "/cards/authorize" }
        ]
      },
      "sales-route": {
        "ClusterId": "sales-cluster",
        "RateLimiterPolicy": "pump-policy",
        "Match": { "Path": "/sales/{**catch-all}" }
      },
      "cards-route": {
        "ClusterId": "loyalty-cluster",
        "Match": {
          "Path": "/cards/{cardNumber}",
          "Methods": [ "GET" ]
        }
      },
      "admin-cards-route": {
        "ClusterId": "loyalty-cluster",
        "Match": { "Path": "/admin/cards/{**catch-all}" }
      },
      "admin-sales-route": {
        "ClusterId": "sales-cluster",
        "Match": { "Path": "/admin/sales/{**catch-all}" }
      }
    },
    "Clusters": {
      "sales-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "sales-1": { "Address": "https://localhost:7161" }
        }
      },
      "loyalty-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "loyalty-1": { "Address": "https://localhost:7171" }
        }
      }
    }
  }
}