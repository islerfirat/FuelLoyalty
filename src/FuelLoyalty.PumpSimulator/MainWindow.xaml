<Window x:Class="FuelLoyalty.PumpSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FuelLoyalty.PumpSimulator.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="FuelLoyalty - Pompa Simülatörü"
        Height="640" Width="960"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,4,0,2" />
            <Setter Property="Foreground" Value="#555" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SOL PANEL ================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="Bağlantı" IsEnabled="{Binding IsIdle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Gateway adresi" />
                        <TextBox Text="{Binding Settings.GatewayUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Label}" Text="İstasyon" />
                                <TextBox Text="{Binding Settings.StationCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Pompa No" />
                                <TextBox Text="{Binding Settings.PumpNo}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Kart ve Yakıt" IsEnabled="{Binding IsIdle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Kart numarası" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding TestCards}"
                                  Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="…4000 Benzin/TL · …4001 Motorin/Litre · …4002 Pasif · …4003 LPG/Bakiye 0" />

                        <TextBlock Style="{StaticResource Label}" Text="Yakıt tipi" />
                        <ComboBox ItemsSource="{Binding FuelTypes}"
                                  SelectedItem="{Binding SelectedFuelType}" />

                        <TextBlock Style="{StaticResource Label}" Text="Birim fiyat (TL/L)" />
                        <TextBox Text="{Binding UnitPrice, StringFormat=N2}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Pompa İşlemleri">
                    <StackPanel>
                        <Button Content="1) Kart Okut" Command="{Binding ReadCardCommand}" />
                        <Button Content="2) Yakıt Ver" Command="{Binding StartFuelingCommand}" />
                        <Button Content="3) Tabancayı As" Command="{Binding StopFuelingCommand}" />
                        <Button Content="4) Satışı Gönder" Command="{Binding SendSaleCommand}" />
                        <Separator Margin="0,8" />
                        <Button Content="Kart Durumu" Command="{Binding GetCardStatusCommand}" />
                        <Button Content="Sıfırla" Command="{Binding ResetCommand}" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= SAĞ PANEL ================= -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LİTRE" Foreground="#AAA" FontSize="13" />
                        <TextBlock Text="{Binding Liters, StringFormat=N2}" Foreground="#4CAF50"
                                   FontSize="40" FontFamily="Consolas" FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TUTAR (TL)" Foreground="#AAA" FontSize="13" />
                        <TextBlock Text="{Binding Amount, StringFormat=N2}" Foreground="#FFC107"
                                   FontSize="40" FontFamily="Consolas" FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ONAYLI LİMİT" Foreground="#AAA" FontSize="13" />
                        <TextBlock Text="{Binding LimitText}" Foreground="#03A9F4"
                                   FontSize="26" FontFamily="Consolas" FontWeight="Bold" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                       FontSize="16" FontWeight="SemiBold" Margin="0,10,0,6" />

            <GroupBox Grid.Row="2" Header="İşlem Kaydı" Margin="0">
                <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12" BorderThickness="0" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>