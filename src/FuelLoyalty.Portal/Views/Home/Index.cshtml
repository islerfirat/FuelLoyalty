@{
    ViewData["Title"] = "Genel Bakış";
    ViewData["Subtitle"] = "FuelLoyalty merkez yönetim ve raporlama portalı";
}

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <a class="app-panel home-tile" asp-controller="Cards" asp-action="Index">
            <div class="app-panel-body d-flex gap-3">
                <div class="stat-icon blue"><i class="bi bi-credit-card-2-front"></i></div>
                <div>
                    <h5 class="mb-1">Kartlar</h5>
                    <p class="text-muted mb-0 small">Kartları listeleyin, yeni kart ekleyin, limit ve durumlarını yönetin.</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-xl-4">
        <a class="app-panel home-tile" asp-controller="Sales" asp-action="Index">
            <div class="app-panel-body d-flex gap-3">
                <div class="stat-icon green"><i class="bi bi-bar-chart-line"></i></div>
                <div>
                    <h5 class="mb-1">Satış Raporu</h5>
                    <p class="text-muted mb-0 small">Tarih, istasyon ve yakıt tipine göre satışları ve toplamları görüntüleyin.</p>
                </div>
            </div>
        </a>
    </div>
</div>